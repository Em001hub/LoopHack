# ============================================
# Intelligence Service Configuration
# ============================================

# ✅ SERVICE IS FULLY FUNCTIONAL WITHOUT ANY OF THESE!
# The service uses smart defaults and heuristics.
# Only configure these if you want specific features.

# --------------------------------------------
# Database (Optional - for persistence)
# --------------------------------------------
# If not set, uses in-memory data (fine for testing)
# DATABASE_URL=postgresql://admin:password@localhost:5432/projectmind

# --------------------------------------------
# Redis (Optional - for caching)
# --------------------------------------------
# If not set, uses in-memory caching
# REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# AI API Keys (Optional - for advanced features)
# --------------------------------------------
# Only needed if you want to use GPT or Claude for insights
# The service works fine with built-in heuristics
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --------------------------------------------
# ML Configuration (Optional)
# --------------------------------------------
# ML_MODEL_PATH=./src/data/models
# ENABLE_GPU=false

# --------------------------------------------
# Feature Flags (All enabled by default)
# --------------------------------------------
# ENABLE_SKILL_EXTRACTION=true
# ENABLE_TIMELINE_PREDICTION=true
# ENABLE_SENTIMENT_ANALYSIS=true
